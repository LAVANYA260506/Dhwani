  ],
  "cross_field_rules": [
    {"id": "marks_not_above_max", "fields": ["marks_obtained", "max_marks"], "rule": "marks_obtained <= max_marks", "message": {"en": "Marks obtained cannot be more than maximum marks.", "kn": "ಗಳಿಸಿದ ಅಂಕಗಳು ಗರಿಷ್ಠ ಅಂಕಗಳಿಗಿಂತ ಹೆಚ್ಚಿರಬಾರದು."}},
    {"id": "percentage_matches_marks", "fields": ["marks_obtained", "max_marks", "percentage"], "rule": "abs(percentage - marks_obtained / max_marks * 100) <= 0.05", "message": {"en": "Percentage does not match the marks entered.", "kn": "ಶೇಕಡಾವಾರು ನಮೂದಿಸಿದ ಅಂಕಗಳಿಗೆ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ."}},
    {"id": "loan_within_funding_gap", "fields": ["loan_amount_requested", "total_course_cost", "margin_money_amount", "scholarship_amount"], "rule": "loan_amount_requested <= total_course_cost - margin_money_amount - scholarship_amount", "message": {"en": "Loan amount cannot exceed course cost minus margin money and scholarship.", "kn": "ಸಾಲದ ಮೊತ್ತವು ಕೋರ್ಸ್ ವೆಚ್ಚದಿಂದ ಮಾರ್ಜಿನ್ ಹಣ ಮತ್ತು ವಿದ್ಯಾರ್ಥಿವೇತನವನ್ನು ಕಳೆದ ಮೊತ್ತಕ್ಕಿಂತ ಹೆಚ್ಚಿರಬಾರದು."}},
    {"id": "course_starts_after_passing", "fields": ["course_start_year", "year_of_passing"], "rule": "course_start_year >= year_of_passing", "message": {"en": "Course start year cannot be before the year of passing.", "kn": "ಕೋರ್ಸ್ ಆರಂಭದ ವರ್ಷವು ಉತ್ತೀರ್ಣರಾದ ವರ್ಷಕ್ಕಿಂತ ಮೊದಲು ಇರಬಾರದು."}},
    {"id": "passing_year_after_birth", "fields": ["year_of_passing", "date_of_birth"], "rule": "year_of_passing - year(date_of_birth) >= 14", "message": {"en": "Year of passing is not consistent with the date of birth.", "kn": "ಉತ್ತೀರ್ಣರಾದ ವರ್ಷವು ಹುಟ್ಟಿದ ದಿನಾಂಕಕ್ಕೆ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ."}},
    {"id": "tenure_covers_reasonable_period", "fields": ["repayment_tenure_years", "course_duration_years"], "rule": "repayment_tenure_years >= 1", "message": {"en": "Repayment period must be at least one year.", "kn": "ಮರುಪಾವತಿ ಅವಧಿ ಕನಿಷ್ಠ ಒಂದು ವರ್ಷ ಇರಬೇಕು."}}
  ]
}