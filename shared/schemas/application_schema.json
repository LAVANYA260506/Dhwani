      {"value": "other", "en": "Other", "kn": "ಇತರೆ"}
    ],
    "category": [
      {"value": "general", "en": "General", "kn": "ಸಾಮಾನ್ಯ"},
      {"value": "obc", "en": "OBC", "kn": "ಒಬಿಸಿ"},
      {"value": "sc", "en": "SC", "kn": "ಎಸ್‌ಸಿ"},
      {"value": "st", "en": "ST", "kn": "ಎಸ್‌ಟಿ"}
