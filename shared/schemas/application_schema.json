        {"id": "declaration_info_true", "type": "checkbox", "label": {"en": "I declare that all the information given is true and correct", "kn": "ನೀಡಿರುವ ಎಲ್ಲಾ ಮಾಹಿತಿ ಸತ್ಯ ಮತ್ತು ಸರಿಯಾಗಿದೆ ಎಂದು ನಾನು ಘೋಷಿಸುತ್ತೇನೆ"}, "required": true, "core": true},
        {"id": "declaration_consent_credit_check", "type": "checkbox", "label": {"en": "I consent to a credit information check", "kn": "ಕ್ರೆಡಿಟ್ ಮಾಹಿತಿ ಪರಿಶೀಲನೆಗೆ ನಾನು ಒಪ್ಪಿಗೆ ನೀಡುತ್ತೇನೆ"}, "required": true, "core": true},
        {"id": "declaration_terms_accepted", "type": "checkbox", "label": {"en": "I accept the terms and conditions", "kn": "ನಿಯಮಗಳು ಮತ್ತು ಷರತ್ತುಗಳನ್ನು ನಾನು ಒಪ್ಪುತ್ತೇನೆ"}, "required": true, "core": true}
      ]
